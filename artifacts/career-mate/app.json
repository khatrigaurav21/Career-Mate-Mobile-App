{
  "expo": {
    "name": "Trozi",
    "slug": "career-mate",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/509ff0ee-064d-4ed7-b819-42cebb6b6c3c"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "career-mate",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FCF9F4",
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.khatrigaurav.careermate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.khatrigaurav.careermate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png",
        "backgroundColor": "#A83223"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "509ff0ee-064d-4ed7-b819-42cebb6b6c3c"
      }
    },
    "owner": "khatri.gaurav"
  }
}
